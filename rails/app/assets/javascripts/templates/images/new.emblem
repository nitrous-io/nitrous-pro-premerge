.card-header.bordered
  h2 New Image

form submit='create target="view"'
  .card-body
    .ui.input-group
      label.field-label
        | Host
      .ui.select
        Ember.Select name='host' content=App.hosts optionValuePath='content.slug' optionLabelPath='content.nameAndSlug' disabled=saving value=selectedHostSlug

    .ui.input-group
      label.field-label for='images-new-name'
        | Name
      = input type='text' name='name' id='images-new-name' disabled=saving value=name

    .ui.input-group
      label.field-label for='images-new-slug'
        | Slug
      = input type='text' name='slug' id='images-new-slug' pattern=App.Image.inputPattern title=App.Image.inputTitle disabled=saving value=slug

  .card-body.bordered
    .ui.input-group
      label.field-label
        | Create from:

      .option-selection
        ul.ui.checkbox-group
          li
            .ui.checkbox
              input type='radio' id='images-new-option-remote' name='option' checked='checked' disabled={saving} value='remote'
              label
            label for='images-new-option-remote' Enter Remote URL

        .indent
          = input type='text' id='images-new-remote-url' name='remote-url' value=remoteURL placeholder='github.com/yourname/repo'

        ul.ui.checkbox-group class={saving:disabled}
          li
            .ui.checkbox
              input type='radio' id='images-new-option-file' name='option' disabled={saving} value='file'
              label
            label for='images-new-option-file' Upload Dockerfile Tarball

        .indent
          .ui.file-picker.btn.raised class={saving:disabled}
            input type='file' id='images-new-file' name='file' disabled={saving} change='didChangeFile target="view"'
          span.filename
            = view.selectedFileName

        ul.ui.checkbox-group class={saving:disabled}
          li
            .ui.checkbox
              input type='radio' id='images-new-option-code' name='option' value='code' disabled={saving}
              label
            label for='images-new-option-code' Enter Dockerfile Code

        .indent
          .editor class={saving:disabled}
            Ember.TextArea id='dockerfile-code' name='dockerfile' rows='1' value=view.dockerfileCode disabled=saving

  .card-footer.bordered
    if saving
      if image.progress.status
        .left
          p
            = image.progress.status
      .right
        button.ui.btn disabled='disabled'
          i.spinner
          | Creating...
    else
      .right
        a.ui.btn href='#' click='cancel' Cancel
        input.ui.btn.primary type='submit' disabled={view.createButtonDisabled} value='Create'
  = ui-progress hide=view.hideProgress indeterminate=view.indeterminateProgress value=image.progress.progressDetail.current max=image.progress.progressDetail.total
