.card-header.bordered
  h2 New Container

form submit='create target="view"'
  .card-body
    .ui.input-group
      label.field-label
        | Host
      .ui.select
        Ember.Select name='host' content=App.hosts optionValuePath='content.slug' optionLabelPath='content.nameAndSlug' disabled=saving value=selectedHostSlug

      label.field-label for='containers-new-name'
        | Name
      = input type='text' id='containers-new-name' name='name' classNameBindings='view.nameFieldInvalid:error' disabled=saving value=name

      label.field-label for='containers-new-slug'
        | Unique Slug
      = input type='text' id='containers-new-slug' name='slug' classNameBindings='view.slugFieldInvalid:error' pattern=App.slug.inputPattern title=App.slug.inputTitle disabled=saving value=slug

  .card-body.bordered
    .ui.input-group
      label.field-label
        | Image

      .image-selection
        ul.ui.checkbox-group class={view.hostImageOptionDisabled:disabled}
          li
            .ui.checkbox
              input type='radio' id='containers-new-option-host-image' name='option' checked='checked' value='host-image' disabled={view.hostImageOptionDisabled}
              label
            label for='containers-new-option-host-image' Use Image On This Host

        .ui.select.indent
          Ember.Select class='option-input' name='containers-new-option-host-image' content=selectedHost.images optionValuePath='content.slugAndTag' optionLabelPath='content.slugAndTag' value=view.selectedHostImage disabled=view.hostImageOptionDisabled

        ul.ui.checkbox-group class={saving:disabled}
          li
            .ui.checkbox
              input type='radio' id='containers-new-option-base-image' name='option' value='base-image' disabled=saving
              label
            label for='containers-new-option-base-image' Use Nitrous.IO Base Image

        .ui.select.indent
          Ember.Select class='option-input' name='containers-new-option-base-image' content=App.baseImages optionValuePath='content.repo' optionLabelPath='content.repo' value=view.selectedBaseImage disabled=saving

        ul.ui.checkbox-group class={saving:disabled}
          li
            .ui.checkbox
              input type='radio' id='containers-new-option-custom-image' name='option' value='custom-image' disabled=saving
              label
            label for='containers-new-option-custom-image' Specify Image Repository

        .indent
          = input type='text' class='option-input' name='containers-new-option-custom-image' placeholder='registry/repo:tag' pattern=App.Image.repoInputPattern title=App.Image.repoInputTitle value=view.customImage disabled=saving

  .card-body.bordered
    .ui.input-group
      label.field-label
        | Container Configuration

      .container-config-btns
        a.ui.btn.raised class={saving:disabled} href='#' click='openVolumeMounts target="view"'
          | Volume Mounts
          if volumeMounts.length
            |&nbsp;(
            = volumeMounts.length
            |)
        a.ui.btn.raised class={saving:disabled} href='#' click='openPortBindings target="view"'
          | Port Bindings
          if portBindings.length
            |&nbsp;(
            = portBindings.length
            |)
        a.ui.btn.raised class={saving:disabled} href='#' click='openEnvVars target="view"'
          | Environment Variables
          if envVars.length
            |&nbsp;(
            = envVars.length
            |)

  .card-footer.bordered
    if saving
      if image.progress.status
        .left
          p
            = image.progress.status
      .right
        button.ui.btn disabled='disabled'
          i.spinner
          | Creating...
    else
      .right
        a.ui.btn href='#' click='cancel' Cancel
        input.ui.btn.primary type='submit' disabled={view.createButtonDisabled} value='Create'
  = ui-progress hide=view.hideProgress indeterminate=view.indeterminateProgress value=image.progress.progressDetail.current max=image.progress.progressDetail.total

#volume-mounts-dialog.ui.modal.container-config
  .ui.card
    h2.card-header
      | Volume Mounts
    form submit='addVolumeMount'
      .card-body
        .ui.input-group
          ul.ui.chips
            each volumeMount in volumeMounts
              li
                = volumeMount
                a.close href='#' click='removeVolumeMount volumeMount' &times;

          table.ui.table
            thead
              tr
                th Volume
                th colspan='2' Mount Point (Optional)
            tbody
              tr
                td
                  .ui.select
                    Ember.Select required=true name='containers-new-selected-volume' content=selectedHost.volumes optionValuePath='content.id' optionLabelPath='content.displayName' value=selectedVolumeId disabled=hostVolumesIsEmpty
                td
                  = input type='text' pattern=view.volumeMountpointInputPattern title=view.volumeMountpointInputTitle placeholder=selectedVolume.defaultMountpoint value=volumeMountpoint
                td
                  input.ui.btn.raised type='submit' disabled={view.addVolumeMountButtonDisabled} value='Add'
      .card-footer
        .right
          a.ui.btn.primary href='#' click='closeVolumeMounts target="view"' Done

#port-bindings-dialog.ui.modal.container-config
  .ui.card
    h2.card-header
      | Port Bindings
    form submit='addPortBinding'
      .card-body
        .ui.input-group
          ul.ui.chips
            each portBinding in portBindings
              li
                = portBinding
                a.close href='#' click='removePortBinding portBinding' &times;

          table.ui.table
            thead
              tr
                th Public
                th Host Port (Optional)
                th colspan='2' Container Port
            tbody
              tr
                td
                  .ui.checkbox
                    = input type='checkbox' checked=publicPort
                    label
                td
                  = input type='number' min='1' max='65535' step='1' placeholder='63000' value=hostPort
                td
                  = input type='number' min='1' max='65535' step='1' placeholder='3000' required=true value=containerPort
                td
                  input.ui.btn.raised type='submit' disabled={view.addPortBindingButtonDisabled} value='Add'

        ul.ui.checkbox-group
          li
            .ui.checkbox
              = input type='checkbox' id='containers-new-publish-all' checked=publishAll
              label
            label for='containers-new-publish-all' Publish All Exposed Ports
    .card-footer
      .right
        button.ui.btn.primary click='closePortBindings target="view"' Done

#env-vars-dialog.ui.modal.container-config
  .ui.card
    h2.card-header
      | Environment Variables
    form submit='addEnvVar'
      .card-body
        .ui.input-group
          ul.ui.chips
            each envVar in envVars
              li
                = envVar
                a.close href='#' click='removeEnvVar envVar' &times;

          table.ui.table
            thead
              tr
                th Key
                th Value
            tbody
              tr
                td
                  = input type='text' placeholder='KEY' required=true value=envKey
                td
                  = input type='text' placeholder='value' required=true value=envValue
                td
                  input.ui.btn.raised type='submit' disabled={view.addEnvVarButtonDisabled} value='Add'
      .card-footer
        .right
          button.ui.btn.primary click='closeEnvVars target="view"' Done
