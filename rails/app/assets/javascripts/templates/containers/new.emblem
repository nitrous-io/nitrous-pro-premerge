.card-header.bordered
  h2 New Container

form
  .card-body
    .ui.input-group
      label.field-label
        | Host
      .ui.select
        Ember.Select content=App.hosts optionValuePath='content.slug' optionLabelPath='content.nameAndSlug' value=selectedHostSlug

      label.field-label for='containers-new-name'
        | Name
      = input type='text' id='containers-new-name' name='name' classNameBindings='view.nameFieldInvalid:error' value=name

      label.field-label for='containers-new-slug'
        | Unique Slug
      = input type='text' id='containers-new-slug' name='slug' classNameBindings='view.slugFieldInvalid:error' pattern=App.slug.inputPattern title=App.slug.inputTitle value=slug

  .card-body.bordered
    .ui.input-group
      label.field-label
        | Image

      .image-selection
        ul.ui.checkbox-group
          li
            .ui.checkbox
              input type='radio' id='containers-new-image-type-host-image' name='image_type' checked='checked'
              label
            label for='containers-new-image-type-host-image' Use Image On This Host

        .ui.select.indent
          Ember.Select content=selectedHost.images optionValuePath='content.id' optionLabelPath='content.nameTagAndId' value=selectedImageId

        ul.ui.checkbox-group
          li
            .ui.checkbox
              input type='radio' id='containers-new-image-type-nitrous' name='image_type'
              label
            label for='containers-new-image-type-nitrous' Use Nitrous.IO Image

        .ui.select.indent
          select
            option Go
            option Node.js
            option PHP
            option Python
            option Python with Django
            option Ruby
            option Ruby on Rails
            option Ubuntu

        ul.ui.checkbox-group
          li
            .ui.checkbox
              input type='radio' id='containers-new-image-type-custom' name='image_type'
              label
            label for='containers-new-image-type-custom' Use Image From Docker Registry

        .indent
          input type='text' id='containers-new-slug' name='slug' placeholder='docker-registry/repo:latest'

  .advanced-options class={view.showAdvanced::hidden}
    .card-body.bordered.volumes
      .ui.input-group
        label.field-label
          | Volumes

        ul.ui.chips
          li
            | code:/volumes/code
            a.close href='#' &times;

          li
            | dotfiles:/dotfiles
            a.close href='#' &times;

        table.ui.table
          thead
            tr
              th Volume
              th colspan='2' Mount Point (Optional)
          tbody
            tr
              td
                .ui.select
                  select
                    option code
                    option dotfiles
                    option db
              td
                input type='text' placeholder='/code'
              td
                button.ui.btn.raised Add

    .card-body.bordered.port-bindings
      .ui.input-group
        label.field-label
          | Port Bindings

        ul.ui.chips
          li
            | Public:80:3000
            a.close href='#' &times;

          li
            | Private:1337:1337
            a.close href='#' &times;

        table.ui.table
          thead
            tr
              th Public
              th Host Port (Optional)
              th colspan='2' Container Port
          tbody
            tr
              td
                .ui.checkbox
                  input type='checkbox'
                  label
              td
                input type='number' min='1' max='65535' step='1' placeholder='63000'
              td
                input type='number' min='1' max='65535' step='1' placeholder='3000'
              td
                button.ui.btn.raised Add

        ul.ui.checkbox-group
          li
            .ui.checkbox
              input type='checkbox' id='containers-new-publish-all' name='publish_all' checked='checked'
              label
            label for='containers-new-publish-all' Publish All Exposed Ports

  .card-footer.bordered
    .left
      button#toggle-advanced-btn.ui.btn click='toggleShowAdvanced target="view"'
        if view.showAdvanced
          | Hide Advanced
        else
          | Show Advanced

    .right
      button.ui.btn Cancel
      button.ui.btn.primary Create
