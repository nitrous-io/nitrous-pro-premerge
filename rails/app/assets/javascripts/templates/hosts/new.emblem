.card-header.bordered
  h2 New Host

form submit='create'
  .card-body
    .ui.flex.horizontal
      .ui.input-group
        label.field-label for='hosts-new-name'
          | Name
        = input type='text' id='hosts-new-name' name='name' classNameBindings='view.nameFieldInvalid:error' disabled=saving value=name

      .ui.input-group
        label.field-label for='hosts-new-slug'
          | Unique Slug
        = input type='text' id='hosts-new-slug' name='slug' classNameBindings='view.slugFieldInvalid:error' pattern=App.slug.inputPattern title=App.slug.inputTitle disabled=saving value=slug

    .ui.input-group
      label.field-label for='hosts-new-region'
        | Region

      ul.ui.checkbox-group.horizontal class={saving:disabled}
        each region in App.regions
          li
            .ui.checkbox
              = input type='radio' name='region' id=region.inputId disabled=saving value=region.slug
              label
            label for={region.inputId}
              = region.name

  .card-body.bordered
    .ui.input-group
      label.field-label
        | Size
      .size-selection
        .size-list
          ul.ui.list.item-1-line
            each plan in App.plans
              li.list-item class={saving:disabled}
                .left-accessory
                  .ui.checkbox
                    = input type='radio' name='size' id=plan.inputId disabled=saving value=plan.slug
                    label
                .lines
                  p
                    label for=plan.inputId
                      = plan.name
                .lines.right
                  p
                    | $&nbsp;
                    = decimal plan.price 2
                    | &nbsp;/&nbsp;mo.

        .size-description
          table.ui.table.horizontal
            tr
              th Max. Containers
              td
                = selectedPlan.maxContainers

            tr
              th Processor Cores
              td
                = selectedPlan.cpu

            tr
              th Total Memory
              td
                = selectedPlan.memory

            tr
              th Total SSD Storage
              td
                = selectedPlan.storage

            tr
              th Container Root Access
              td
                i.fa.fa-check
                  span Yes

            tr
              th Vagrant Provider
              td
                i.fa.fa-check
                  span Yes

            tr
              th Custom Domains
              td
                i.fa.fa-check
                  span Yes

    p.see-terms
      | Please review the&nbsp;
      a href='#' terms of service
      |, and&nbsp;
      a href='#' privacy policy
      |. All sales are final.

  .card-footer.bordered
    if saving
      if host.progress.status
        .left
          p
            = host.progress.status
      .right
        button.ui.btn disabled='disabled'
          i.spinner
          | Creating...
    else
      .right
        a.ui.btn href='#' click='cancel' Cancel
        input.ui.btn.primary type='submit' disabled={view.createButtonDisabled} value='Create'
  = ui-progress hide=view.hideProgress indeterminate=true
