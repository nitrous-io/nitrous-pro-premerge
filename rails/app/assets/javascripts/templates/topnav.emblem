.container
  ul.nav.left
    li
      link-to 'home.index'
        h1.logo
          | Nitrous
          span .IO
  ul.nav.right
    if App.user
      li
        a href='#'
          img.gravatar src={App.user.gravatar}
          = App.user.username
      li.ui.dropdown
        a href='#'
          | New
          .ui.dropdown-triangle
        ul.dropdown-menu style='display: none'
          li
            link-to 'hosts.new' | New Host...
          li
            link-to 'images.new' | New Image...
          li
            link-to 'containers.new' | New Container...
      li.ui.dropdown
        a href='#'
          | Account
          .ui.dropdown-triangle
        ul.dropdown-menu.right style='display: none'
          li.disabled
            a href='#' Account Settings
          li.disabled
            a href='#' Billing
          li.separator
          li.disabled
            a href='#' Help
          li.separator
          li
            link-to 'logout' | Log Out
    else
      li
        a href='#' Features
      li
        a href='#' Documentation
      li
        a href='#' Blog
      li.primary
        link-to 'signup' | Sign Up
      li.primary
        link-to 'login' | Log In
