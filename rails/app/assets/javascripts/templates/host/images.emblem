= host-tab-bar selected='images' host=model

.card-body
  if records.loaded
    if records.length
      ul.ui.list.with-separators.item-2-line
        each image in records
          li.list-item
            .left-accessory
              .ui.checkbox
                input.record-checkbox type='checkbox' id={image.inputId} value={image.id} disabled={image.updating}
                label
            .lines
              label for={image.inputId}
                h4
                  = image.displayName
                p
                  if image.progress.status
                    = image.progress.status
                  else
                    = image.slugAndTag
                    span.sep
                    | Created&nbsp;
                    = ago image.createdAt
            .right-accessory
              button.ui.btn click='showPushDialog image target="view"' disabled={image.updating} Push...
    else
      p.hint-text
        i.fa.fa-exclamation-circle
        | This host is not connected to any Docker registry.
  else
    p.hint-text
      i.spinner
      | Loading...

.card-footer.bordered
  .left
    if removing
      button.ui.btn disabled='disabled'
        i.spinner
        | Removing...
    else
        button.ui.btn click='update target="view"' disabled=noneSelected Update
        button.ui.btn click='askRemove target="view"' disabled=noneSelected Remove
  .right
    button.ui.btn click='add' New Image...
    button.ui.btn.primary click='pull' Pull Image...

#push-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Push &ldquo;
      = image.displayName
      | &rdquo;
    form submit='push'
      .card-body
        .ui.input-group
          label.field-label for='push-repo'
            | Image Repository
          = input type='text' id='push-repo' disabled=image.pushing value=repo placeholder='registry/repo:tag' pattern=App.Image.repoInputPattern title=App.Image.repoInputTitle required=true
      .card-footer
        .right
          if image.pushing
            button.ui.btn disabled='disabled'
              i.spinner
              | pushing...
          else
            a.ui.btn href='#' click='cancelPush target="view"' Cancel
            input.ui.btn.primary type='submit' disabled=view.pushButtonDisabled value='Push'

#confirm-remove-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you sure?
    .card-body
      p
        | Are you sure you want to remove the following image
        if view.multipleSelected
          | s
        | ?
      ul.comma-separated
        each record in selected
          li
            | &ldquo;
            = record.displayName
            | &rdquo;

    .card-footer
      .right
        button.ui.btn click='cancelRemove target="view"' Cancel
        button.ui.btn.danger.terminate-btn click='confirmRemove target="view"' Remove
