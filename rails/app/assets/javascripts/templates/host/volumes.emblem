= host-tab-bar selected='volumes'

.card-body
  if volumes.loaded
    if volumes.length
      ul.ui.list.with-separators.item-2-line
        each volume in volumes
          li.list-item
            .left-accessory
              .ui.checkbox
                input type='checkbox' name='volume' id={volume.inputId} value={volume.slug}
                label
            .lines
              label for={volume.inputId}
                h4
                  = volume.displayName
                p
                  = volume.slug
                  span.sep
                  | Created&nbsp;
                  = ago createdAt
                  span.sep
                  a href='#' Calculate Size

    else
      p.hint-text
        i.fa.fa-exclamation-circle
        | This host does not have any volumes.
  else
    p.hint-text
      i.spinner
      | Loading...

.card-footer.bordered
  .left
    button.ui.btn click='remove target="view"' Remove
  .right
    button.ui.btn.primary click='new' New Volume...
