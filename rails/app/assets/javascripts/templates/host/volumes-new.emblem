= host-tab-bar selected='volumes'

form submit='create'
  .card-body
    h3 New Volume
    .ui.input-group
      label.field-label for='volumes-new-name'
        | Name
      = input type='text' id='volumes-new-name' name='name' value=name

      label.field-label for='volumes-new-slug'
        | Unique Slug
      = input type='text' id='volumes-new-slug' name='slug' pattern=App.slug.inputPattern title=App.slug.inputTitle value=slug

  .card-footer.bordered
    .right
      if saving
        button.ui.btn disabled='disabled'
          i.spinner
          | Creating...
      else
        a.ui.btn href='#' click='cancel' Cancel
        input.ui.btn.primary type='submit' disabled={view.createButtonDisabled} value='Create'
