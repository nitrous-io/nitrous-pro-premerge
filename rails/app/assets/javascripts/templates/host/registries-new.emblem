= host-tab-bar selected='registries' host=model

form submit='create'
  .card-body
    h3 Connect To Registry
    .ui.input-group
      label.field-label for='registries-new-url'
        | Registry URL
      .registry-url
        = input type='text' id='registries-new-url' name='registry' value=url disabled=saving
        .registry-buttons
          a.ui.btn.raised class={saving:disabled} id='quay-io-btn' data-url='quay.io' href='#'
            | Quay.io
          a.ui.btn.raised.default class={saving:disabled} id='docker-hub-btn' data-url='https://index.docker.io/v1/' href='#'
            | Docker Hub

    .ui.input-group
      label.field-label for='registries-new-username'
        | Username
      = input type='text' id='registries-new-username' name='username' value=username disabled=saving

    .ui.input-group
      label.field-label for='registries-new-email'
        | Email
      = input type='email' id='registries-new-email' name='email' value=email disabled=saving

    .ui.input-group
      label.field-label for='registries-new-password'
        | Password
      = input type='password' id='registries-new-password' name='password' value=password disabled=saving

  .card-footer.bordered
    .right
      if saving
        button.ui.btn disabled='disabled'
          i.spinner
          | Connecting...
      else
        a.ui.btn href='#' click='cancel' Cancel
        input.ui.btn.primary type='submit' disabled={view.createButtonDisabled} value='Connect'
