#!/bin/bash
set -e
VERSION=${1:?"version is required"}
BUILD_DIR=./build

for A in nitrousd dbseed; do
        rm -f "$BUILD_DIR/$A"
done
mkdir -p "$BUILD_DIR"

VERSION=$VERSION goop go install -x -ldflags "-X main.version ${VERSION}" -v ./...
BUILD_DIR=$BUILD_DIR goop exec bash -c 'cp $GOBIN/nitrousd $BUILD_DIR/nitrousd'
BUILD_DIR=$BUILD_DIR goop exec bash -c 'cp $GOBIN/dbseed $BUILD_DIR/dbseed'
